ARG_ENABLE("numerus", "whether to enable numerus support", "no");

if (PHP_NUMERUS != "no") {
    ADD_FLAG("CFLAGS_NUMERUS", "/Isrc\\core /Isrc\\storage /Isrc\\matrix /Isrc\\statistics");
    EXTENSION("numerus", "src/numerus.c src/matrix/numerus_matrix.c src/matrix/numerus_matrix_analysis.c src/matrix/numerus_matrix_binary.c src/matrix/numerus_matrix_cholesky.c src/matrix/numerus_matrix_compare.c src/matrix/numerus_matrix_compare_close.c src/matrix/numerus_matrix_condition.c src/matrix/numerus_matrix_constructors.c src/matrix/numerus_matrix_definiteness.c src/matrix/numerus_matrix_elementwise.c src/matrix/numerus_matrix_elimination.c src/matrix/numerus_matrix_exponential.c src/matrix/numerus_matrix_inverse.c src/matrix/numerus_matrix_inverse_gauss_jordan.c src/matrix/numerus_matrix_kronecker.c src/matrix/numerus_matrix_ldlt.c src/matrix/numerus_matrix_least_squares.c src/matrix/numerus_matrix_log_determinant.c src/matrix/numerus_matrix_lu.c src/matrix/numerus_matrix_map.c src/matrix/numerus_matrix_materialize.c src/matrix/numerus_matrix_multiply.c src/matrix/numerus_matrix_normalize.c src/matrix/numerus_matrix_null_space.c src/matrix/numerus_matrix_polynomial.c src/matrix/numerus_matrix_power.c src/matrix/numerus_matrix_pseudoinverse.c src/matrix/numerus_matrix_qr.c src/matrix/numerus_matrix_solve.c src/matrix/numerus_matrix_solve_triangular.c src/matrix/numerus_matrix_spaces.c src/matrix/numerus_matrix_spectral.c src/matrix/numerus_matrix_statistics.c src/matrix/numerus_matrix_svd.c src/matrix/numerus_matrix_symmetric_eigen.c src/matrix/numerus_matrix_symmetric_functions.c src/matrix/numerus_matrix_system.c src/matrix/numerus_matrix_views.c src/matrix/numerus_matrix_weighted_least_squares.c src/core/numerus_numeric.c src/statistics/numerus_optimizer.c src/statistics/numerus_probability.c src/statistics/numerus_rng.c src/statistics/numerus_rng_sampling.c src/storage/numerus_storage.c");
}
